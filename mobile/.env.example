# Alamat dasar backend Laravel (TANPA /api/v1 — itu ditambahkan otomatis).
#
# Emulator Android  : http://10.0.2.2:8000
# Simulator iOS     : http://127.0.0.1:8000
# Perangkat fisik   : http://<IP-LAN-komputer>:8000  (mis. http://192.168.1.10:8000)
# Produksi          : https://domain-anda.com
#
# Jalankan backend dengan `php artisan serve --host=0.0.0.0` agar bisa diakses
# dari perangkat lain di jaringan yang sama.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
