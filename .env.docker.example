DOCKER_IMAGE=dockerhub-username/monitoring-spbu:latest
APP_PORT=8080

APP_NAME="Monitoring SPBU"
APP_ENV=production
APP_KEY=base64:replace_with_output_of_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://example.com
LOG_LEVEL=info

POSTGRES_DB=monitoring_spbu
POSTGRES_USER=monitoring_spbu
POSTGRES_PASSWORD=change-this-password

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

CREATE_STORAGE_LINK=true
LARAVEL_OPTIMIZE=true
RUN_MIGRATIONS=false
